{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StackExcalidrawOnly",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateChangeSet",
        "cloudformation:DescribeChangeSet",
        "cloudformation:ExecuteChangeSet",
        "cloudformation:DeleteChangeSet",
        "cloudformation:DescribeStacks",
        "cloudformation:DescribeStackEvents",
        "cloudformation:DescribeStackResources",
        "cloudformation:GetTemplateSummary",
        "cloudformation:DeleteStack"
      ],
      "Resource": "arn:aws:cloudformation:us-east-1:<ACCOUNT_ID>:stack/excalidraw/*"
    },
    {
      "Sid": "UbuntuImageLookup",
      "Effect": "Allow",
      "Action": "ssm:GetParameters",
      "Resource": "arn:aws:ssm:us-east-1::parameter/aws/service/canonical/ubuntu/*"
    },
    {
      "Sid": "ReadOnlyNoResourceLevelSupport",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceStatus",
        "ec2:DescribeInstanceTypes",
        "ec2:DescribeImages",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeAddresses",
        "ec2:DescribeLaunchTemplates",
        "ec2:DescribeLaunchTemplateVersions",
        "ec2:DescribeSubnets",
        "ec2:DescribeVpcs",
        "ec2:DescribeNetworkInterfaces",
        "ec2:DescribeVolumes",
        "ec2:DescribeTags",
        "ec2:DescribeAccountAttributes",
        "ssm:GetCommandInvocation",
        "tag:GetResources"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Ec2CreateOnlyWhenTagged",
      "Effect": "Allow",
      "Action": ["ec2:RunInstances", "ec2:CreateSecurityGroup", "ec2:AllocateAddress", "ec2:CreateLaunchTemplate"],
      "Resource": [
        "arn:aws:ec2:us-east-1:<ACCOUNT_ID>:instance/*",
        "arn:aws:ec2:us-east-1:<ACCOUNT_ID>:volume/*",
        "arn:aws:ec2:us-east-1:<ACCOUNT_ID>:network-interface/*",
        "arn:aws:ec2:us-east-1:<ACCOUNT_ID>:security-group/*",
        "arn:aws:ec2:us-east-1:<ACCOUNT_ID>:elastic-ip/*",
        "arn:aws:ec2:us-east-1:<ACCOUNT_ID>:launch-template/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "excalidraw"
        }
      }
    },
    {
      "Sid": "Ec2LaunchIntoDefaultVpcWithUbuntu",
      "Effect": "Allow",
      "Action": ["ec2:RunInstances", "ec2:CreateSecurityGroup"],
      "Resource": ["arn:aws:ec2:us-east-1::image/*", "arn:aws:ec2:us-east-1:<ACCOUNT_ID>:subnet/*", "arn:aws:ec2:us-east-1:<ACCOUNT_ID>:vpc/*"]
    },
    {
      "Sid": "Ec2UseTaggedSecurityGroupAndTemplate",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": ["arn:aws:ec2:us-east-1:<ACCOUNT_ID>:security-group/*", "arn:aws:ec2:us-east-1:<ACCOUNT_ID>:launch-template/*"],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "excalidraw"
        }
      }
    },
    {
      "Sid": "Ec2TagOnCreateOnly",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": [
        "arn:aws:ec2:us-east-1:<ACCOUNT_ID>:instance/*",
        "arn:aws:ec2:us-east-1:<ACCOUNT_ID>:volume/*",
        "arn:aws:ec2:us-east-1:<ACCOUNT_ID>:network-interface/*",
        "arn:aws:ec2:us-east-1:<ACCOUNT_ID>:security-group/*",
        "arn:aws:ec2:us-east-1:<ACCOUNT_ID>:elastic-ip/*",
        "arn:aws:ec2:us-east-1:<ACCOUNT_ID>:launch-template/*"
      ],
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": ["RunInstances", "CreateSecurityGroup", "AllocateAddress", "CreateLaunchTemplate"]
        }
      }
    },
    {
      "Sid": "Ec2ChangeTaggedOnly",
      "Effect": "Allow",
      "Action": [
        "ec2:TerminateInstances",
        "ec2:StopInstances",
        "ec2:StartInstances",
        "ec2:ModifyInstanceAttribute",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:DeleteSecurityGroup",
        "ec2:AssociateAddress",
        "ec2:DisassociateAddress",
        "ec2:ReleaseAddress",
        "ec2:CreateLaunchTemplateVersion",
        "ec2:ModifyLaunchTemplate",
        "ec2:DeleteLaunchTemplate"
      ],
      "Resource": [
        "arn:aws:ec2:us-east-1:<ACCOUNT_ID>:instance/*",
        "arn:aws:ec2:us-east-1:<ACCOUNT_ID>:security-group/*",
        "arn:aws:ec2:us-east-1:<ACCOUNT_ID>:elastic-ip/*",
        "arn:aws:ec2:us-east-1:<ACCOUNT_ID>:launch-template/*",
        "arn:aws:ec2:us-east-1:<ACCOUNT_ID>:network-interface/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "excalidraw"
        }
      }
    },
    {
      "Sid": "IamRoleForThisStackOnly",
      "Effect": "Allow",
      "Action": ["iam:CreateRole", "iam:DeleteRole", "iam:GetRole", "iam:TagRole", "iam:UntagRole", "iam:PutRolePolicy", "iam:DeleteRolePolicy", "iam:GetRolePolicy", "iam:ListRolePolicies", "iam:ListAttachedRolePolicies"],
      "Resource": "arn:aws:iam::<ACCOUNT_ID>:role/excalidraw-*"
    },
    {
      "Sid": "IamOnlyTheSsmManagedPolicy",
      "Effect": "Allow",
      "Action": ["iam:AttachRolePolicy", "iam:DetachRolePolicy"],
      "Resource": "arn:aws:iam::<ACCOUNT_ID>:role/excalidraw-*",
      "Condition": {
        "ArnEquals": {
          "iam:PolicyARN": "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
        }
      }
    },
    {
      "Sid": "IamPassRoleOnlyToEc2",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::<ACCOUNT_ID>:role/excalidraw-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ec2.amazonaws.com"
        }
      }
    },
    {
      "Sid": "IamInstanceProfileForThisStackOnly",
      "Effect": "Allow",
      "Action": ["iam:CreateInstanceProfile", "iam:DeleteInstanceProfile", "iam:GetInstanceProfile", "iam:AddRoleToInstanceProfile", "iam:RemoveRoleFromInstanceProfile"],
      "Resource": "arn:aws:iam::<ACCOUNT_ID>:instance-profile/excalidraw-*"
    },
    {
      "Sid": "DynamoDbTableForThisStackOnly",
      "Effect": "Allow",
      "Action": [
        "dynamodb:CreateTable",
        "dynamodb:DescribeTable",
        "dynamodb:UpdateTable",
        "dynamodb:DescribeContinuousBackups",
        "dynamodb:UpdateContinuousBackups",
        "dynamodb:DescribeTimeToLive",
        "dynamodb:TagResource",
        "dynamodb:UntagResource",
        "dynamodb:ListTagsOfResource"
      ],
      "Resource": "arn:aws:dynamodb:us-east-1:<ACCOUNT_ID>:table/excalidraw-*"
    },
    {
      "Sid": "S3BucketForThisStackOnly",
      "Effect": "Allow",
      "Action": ["s3:CreateBucket", "s3:GetBucketLocation", "s3:PutBucketPublicAccessBlock", "s3:GetBucketPublicAccessBlock", "s3:PutBucketTagging", "s3:GetBucketTagging"],
      "Resource": "arn:aws:s3:::excalidraw-*"
    },
    {
      "Sid": "ResourceGroupForThisStackOnly",
      "Effect": "Allow",
      "Action": [
        "resource-groups:CreateGroup",
        "resource-groups:DeleteGroup",
        "resource-groups:GetGroup",
        "resource-groups:GetGroupQuery",
        "resource-groups:UpdateGroup",
        "resource-groups:UpdateGroupQuery",
        "resource-groups:Tag",
        "resource-groups:Untag",
        "resource-groups:GetTags",
        "resource-groups:ListGroupResources"
      ],
      "Resource": ["arn:aws:resource-groups:us-east-1:<ACCOUNT_ID>:group/excalidraw", "arn:aws:resource-groups:us-east-1:<ACCOUNT_ID>:group/excalidraw/*"]
    },
    {
      "Sid": "UpdateCommandOnTaggedInstanceOnly",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": "arn:aws:ec2:us-east-1:<ACCOUNT_ID>:instance/*",
      "Condition": {
        "StringEquals": {
          "ssm:resourceTag/Project": "excalidraw"
        }
      }
    },
    {
      "Sid": "UpdateCommandShellDocumentOnly",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": "arn:aws:ssm:us-east-1::document/AWS-RunShellScript"
    }
  ]
}
